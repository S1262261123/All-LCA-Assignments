#include<stdio.h>
int main(){
        int choice;
        float num1,num2,num3;
        printf("Basic Arithematic Calculator Menu\n");
        printf("Addition\n")
        printf("2. Subtraction\n");
        printf("3. Multiplication\n");
        printf("4. Division\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        if (choice == 5) {
            printf("Exiting program.\n");
            break;
        }

        printf("Enter two numbers: ");
        scanf("%d %d", &num1, &num2);

        switch (choice) {
            case 1:
                printf("Result: %d\n", num1 + num2);
                break;
            case 2:
                printf("Result: %d\n", num1 - num2);
                break;
            case 3:
                printf("Result: %d\n", num1 * num2);
                break;
            case 4:
                if (num2 == 0) {
                    printf("Error: Division by zero!\n");
                } else {
                    printf("Result: %.2f\n", (float)num1 / num2);
                }
                break;
            default:
                printf("Invalid choice.\n");
        }
    }
    return 0;
}
